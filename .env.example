# ---------------------------------------------------------------------------
# Configuración compartida por los tres servicios.
# Copiar a `.env` antes de levantar docker compose:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Seguridad (JWT) -------------------------------------------------------
# Secreto HS256 compartido por la API Go (que emite el token) y la API Node
# (que lo verifica). Debe ser idéntico en ambas.
# Generar uno real con:  openssl rand -base64 48
# En producción debe venir de un gestor de secretos, nunca de un archivo
# versionado.
JWT_SECRET=cambiar-este-secreto-por-uno-largo-y-aleatorio-en-produccion
JWT_ISSUER=interseguro-qr-api
JWT_AUDIENCE=interseguro-clients
JWT_TTL_MINUTES=15

# Credenciales del endpoint POST /api/v1/auth/login.
# Sustituyen a una base de usuarios real, fuera del alcance del desafío.
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234

# --- API Go (factorización QR) ---------------------------------------------
GO_API_PORT=8080
# URL de la API Node vista desde la API Go. En docker compose se resuelve por
# el nombre del servicio dentro de la red interna.
STATS_API_URL=http://api-node:3000
# Timeout de cada intento y reintentos ante fallo transitorio.
STATS_API_TIMEOUT_SECONDS=5
STATS_API_MAX_RETRIES=1
# Orígenes autorizados para llamadas directas desde un navegador. El frontend
# desplegado usa el proxy del mismo origen; esta lista cubre desarrollo local.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# --- API Node (estadísticas) -----------------------------------------------
NODE_API_PORT=3000
NODE_ENV=production
LOG_LEVEL=info
# Máximo de matrices aceptadas por petición.
MAX_MATRICES=16

# --- Límites compartidos ----------------------------------------------------
# Máximo de filas y de columnas por matriz. Acota el costo de la factorización,
# que crece como O(m·n²). Ambas APIs lo aplican por separado.
MAX_MATRIX_DIMENSION=256

# --- Frontend ---------------------------------------------------------------
FRONTEND_PORT=8081
